# ─────────────────────────────────────────────────────────────
# DCIM 환경 변수 템플릿
#
# 사용법:
#   1) 이 파일을 .env 로 복사:       cp .env.example .env
#   2) 아래 "★ 반드시 수정" 표시된 3~4개 값만 실제 값으로 교체
#   3) 보안상 .env 파일 권한 제한:   chmod 600 .env
#
# 주의: .env 는 .gitignore 에 등록되어 커밋되지 않습니다.
#      비밀번호는 절대 git 에 올리지 마세요.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# docker-compose.yml 의 db 서비스 기본값과 맞춰져 있어 그대로 두어도 됩니다.
DATABASE_URL="postgresql://dcim:dcim_password@localhost:5432/dcim?schema=public"

# ── Prometheus (external) ────────────────────────────────────
# 2026-04-13 현장 확인 결과: 실제 Prometheus 는 Lab3 의 NodePort 주소입니다.
# Lab1 (Room A) 의 Prometheus 는 K8s 내부 DNS 라 외부 서버에서 직접 접근 불가.
# → 멀티 Prometheus 대응은 todo.md §8 참고. 현재는 Lab3 단일 소스로 운영.
PROMETHEUS_URL="http://10.144.131.100:30003"

# ── NextAuth (self-authentication) ───────────────────────────
# 앱이 3001 포트로 뜬다면 이 값을 http://localhost:3001 로 맞춰주세요.
# 외부에서 접근할 경우 http://<서버IP>:3001 또는 실제 도메인으로 변경.
NEXTAUTH_URL="http://localhost:3001"

# ★ 반드시 수정 ★
# 아래 명령으로 랜덤 값 생성 후 붙여넣기:
#   openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"

# ── WebSocket (사용 중이면) ───────────────────────────────────
WS_PORT=3001

# ── BMC / Redfish credentials (fleet-wide) ───────────────────
# 전체 BMC 공용 관리자 계정. 함대 내 BMC 가 동일 자격증명을 쓴다는 전제.
# Dell iDRAC 기본: root / calvin
# HPE iLO  기본: Administrator / <개별 서버 비밀번호>
#
# ★ 반드시 수정 ★ - 실제 운영 비밀번호로 교체
BMC_USERNAME="root"
BMC_PASSWORD="CHANGE_ME_actual_bmc_password"
